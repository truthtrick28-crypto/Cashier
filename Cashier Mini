<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Kasir POS Pro Modern</title>
    <style>
        :root {
            --bg-body: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --input-bg: #ffffff;
            --hover-bg: #f8fafc;
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --success: #10b981;
            --success-bg: rgba(16, 185, 129, 0.12);
            --warning: #f59e0b;
            --danger: #ef4444;
            --danger-bg: rgba(239, 68, 68, 0.12);
            --info: #0ea5e9;
            --info-bg: rgba(14, 165, 233, 0.12);
            --shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        }

        [data-theme="dark"] {
            --bg-body: #090d16;
            --bg-card: #151c2c;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #273248;
            --input-bg: #0f1522;
            --hover-bg: #1e283d;
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --success: #34d399;
            --success-bg: rgba(52, 211, 153, 0.15);
            --warning: #fbbf24;
            --danger: #f87171;
            --danger-bg: rgba(248, 113, 113, 0.15);
            --info: #38bdf8;
            --info-bg: rgba(56, 189, 248, 0.15);
            --shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.3);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            padding: 16px;
        }

        .container {
            max-width: 1320px;
            margin: 0 auto;
        }

        /* HEADER */
        .header-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }
        @media(max-width: 850px) {
            .header-grid { grid-template-columns: 1fr; }
        }

        .header-bar {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 18px 22px;
            border-radius: 16px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow);
        }

        .income-title {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .income-amount {
            font-size: 26px;
            font-weight: 800;
            color: var(--success);
            margin-top: 2px;
        }

        .laci-amount {
            font-size: 26px;
            font-weight: 800;
            color: var(--info);
            margin-top: 2px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 8px 12px;
            font-size: 12px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-theme { background: var(--border-color); color: var(--text-main); }
        .btn-kurangi { background: rgba(245, 158, 11, 0.15); color: var(--warning); }
        .btn-reset { background: var(--danger-bg); color: var(--danger); }
        .btn-download { background: var(--success-bg); color: var(--success); }
        .btn-modal { background: var(--info-bg); color: var(--info); }
        .btn-backup { background: rgba(99, 102, 241, 0.15); color: var(--primary); }

        /* LAYOUT UTAMA */
        .app-grid {
            display: grid;
            grid-template-columns: 1.35fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        @media (max-width: 960px) {
            .app-grid { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: 16px;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        h2, h3 {
            color: var(--text-main);
            margin-bottom: 14px;
            font-size: 17px;
            font-weight: 700;
        }

        /* FORM & INPUT */
        .form-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1.2fr auto;
            gap: 8px;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 2px dashed var(--border-color);
        }
        @media (max-width: 650px) {
            .form-grid { grid-template-columns: 1fr; }
        }

        input, select {
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 14px;
            width: 100%;
            background: var(--input-bg);
            color: var(--text-main);
            outline: none;
        }
        input:focus, select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        /* SEARCH BAR MENU */
        .search-box {
            position: relative;
            margin-bottom: 14px;
        }
        .search-box input {
            padding-left: 38px;
            background: var(--hover-bg);
            font-weight: 500;
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 15px;
        }

        /* FILTER TABS */
        .filter-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }
        .tab-btn {
            background: var(--border-color);
            color: var(--text-muted);
            padding: 6px 14px;
            font-size: 13px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 500;
        }
        .tab-btn.active {
            background: var(--primary);
            color: white;
            font-weight: 600;
        }

        /* MENU GRID & DRAG/SORT */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
            gap: 12px;
            max-height: 440px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .menu-item {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: var(--hover-bg);
            position: relative;
            cursor: grab;
        }
        .menu-item:active { cursor: grabbing; }
        .menu-item.drag-over {
            border: 2px dashed var(--primary);
            background: rgba(99, 102, 241, 0.08);
        }
        .menu-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .badge {
            font-size: 10px;
            background: var(--border-color);
            color: var(--text-muted);
            padding: 3px 8px;
            border-radius: 20px;
            text-transform: uppercase;
            font-weight: 600;
        }
        .menu-card-actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .btn-icon-mini {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            width: 22px;
            height: 22px;
            border-radius: 5px;
            font-size: 11px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-icon-mini:hover { color: var(--primary); border-color: var(--primary); }
        .btn-icon-mini.del:hover { color: var(--danger); border-color: var(--danger); }

        .menu-name { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
        .menu-price { color: var(--success); font-weight: 700; font-size: 13px; margin-bottom: 10px; }
        .menu-reorder-bar { display: flex; justify-content: space-between; margin-bottom: 8px; gap: 4px; }
        .btn-move {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 10px;
            padding: 3px 0;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 700;
        }
        .btn-move:hover { background: var(--border-color); color: var(--text-main); }
        .qty-control {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px;
        }
        .qty-btn {
            width: 28px;
            height: 28px;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-minus { background: var(--danger-bg); color: var(--danger); }
        .btn-plus { background: var(--success-bg); color: var(--success); }
        .qty-val { font-weight: 700; font-size: 13px; }

        /* PESANAN GANTUNG */
        .pending-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 240px;
            overflow-y: auto;
        }
        .pending-card {
            background: var(--hover-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            overflow: hidden;
        }
        .pending-header {
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }
        .pending-header:hover { background: rgba(99, 102, 241, 0.06); }
        .pending-info { display: flex; align-items: center; gap: 10px; }
        .pending-title { font-weight: 700; font-size: 14px; }
        .pending-total { font-size: 13px; font-weight: 700; color: var(--success); }
        .pending-actions { display: flex; align-items: center; gap: 6px; }
        .btn-load-pending {
            background: var(--primary);
            color: white;
            padding: 4px 10px;
            font-size: 11px;
            border-radius: 6px;
            border: none;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-toggle-pending {
            background: var(--border-color);
            color: var(--text-main);
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: none;
            font-size: 11px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-del-pending {
            background: var(--danger-bg);
            color: var(--danger);
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: none;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pending-details {
            display: none;
            padding: 10px 14px;
            border-top: 1px dashed var(--border-color);
            background: var(--bg-card);
            font-size: 12px;
            color: var(--text-muted);
        }
        .pending-details.open { display: block; }
        .pending-details ul { list-style: none; padding-left: 0; }
        .pending-details li { display: flex; justify-content: space-between; padding: 3px 0; }

        /* KERANJANG */
        .cart-list {
            max-height: 190px;
            overflow-y: auto;
            margin-bottom: 14px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }
        .cart-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 4px;
            border-bottom: 1px dashed var(--border-color);
            font-size: 13px;
            gap: 8px;
        }
        .cart-subtotal { font-weight: 700; min-width: 85px; text-align: right; }

        /* PEMBAYARAN & METODE */
        .highlight-box {
            background: var(--hover-bg);
            border: 2px solid var(--border-color);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 15px;
        }
        .total-display-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 12px 16px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .total-label { font-size: 14px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
        .total-value { font-size: 26px; font-weight: 900; color: var(--text-main); letter-spacing: -0.5px; }

        .pay-method-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 12px;
        }
        .pay-tab-btn {
            background: var(--border-color);
            color: var(--text-muted);
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
        }
        .pay-tab-btn.active { background: var(--primary); color: white; }

        .pay-input {
            font-size: 22px;
            font-weight: 800;
            text-align: right;
            margin-bottom: 10px;
            padding: 12px 14px;
            border: 2px solid var(--primary);
        }

        .quick-cash {
            display: flex;
            gap: 6px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }
        .cash-chip {
            background: var(--border-color);
            color: var(--text-main);
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-weight: 600;
        }
        .cash-chip .del-chip { color: var(--danger); }

        .kembalian-display-card {
            background: var(--success-bg);
            border: 1.5px solid var(--success);
            padding: 14px 16px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
        }
        .kembalian-display-card.kurang { background: var(--danger-bg); border-color: var(--danger); }
        .kembalian-label { font-size: 14px; font-weight: 800; text-transform: uppercase; color: var(--success); }
        .kembalian-display-card.kurang .kembalian-label { color: var(--danger); }
        .kembalian-value { font-size: 24px; font-weight: 900; color: var(--success); }
        .kembalian-display-card.kurang .kembalian-value { color: var(--danger); }

        .action-btns {
            display: grid;
            grid-template-columns: 1fr 1.2fr 1.8fr;
            gap: 8px;
        }
        @media(max-width: 500px) {
            .action-btns { grid-template-columns: 1fr; }
        }

        /* BARANG TERJUAL */
        .sold-items-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-height: 150px;
            overflow-y: auto;
        }
        .sold-badge {
            background: var(--hover-bg);
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .sold-badge span {
            background: var(--primary);
            color: white;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 11px;
        }

        /* LOG AKTIVITAS */
        .log-list {
            max-height: 250px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .log-item {
            background: var(--hover-bg);
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--primary);
            padding: 12px 16px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            font-size: 13px;
        }
        .log-item.masuk { border-left-color: var(--success); }
        .log-item.keluar { border-left-color: var(--warning); }
        .log-item.reset { border-left-color: var(--danger); }
        .log-time { font-size: 11px; color: var(--text-muted); margin-bottom: 3px; font-weight: 500; }
        .log-title { font-weight: 700; margin-bottom: 2px; }
        .log-detail { color: var(--text-muted); white-space: pre-line; }

        /* CUSTOM MODAL */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            backdrop-filter: blur(3px);
            padding: 15px;
        }
        .modal-box {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 24px;
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .modal-box h3 { margin-bottom: 10px; color: var(--text-main); }
        .modal-box p { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
        .modal-field { margin-bottom: 12px; }
        .modal-field label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 5px; }
        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 16px;
        }
    </style>
</head>
<body data-theme="light">

<div class="container">
    <!-- HEADER GRID -->
    <div class="header-grid">
        <div class="header-bar">
            <div>
                <div class="income-title">Total Pendapatan Hari Ini</div>
                <div class="income-amount">Rp <span id="displayPendapatan">0</span></div>
            </div>
            <div class="header-actions">
                <button class="btn btn-download" onclick="downloadLaporan()">📥 Laporan</button>
                <button class="btn btn-kurangi" onclick="kurangiPendapatanPrompt()">➖ Kurangi</button>
                <button class="btn btn-reset" onclick="resetPendapatan()">🔄 Reset</button>
            </div>
        </div>

        <div class="header-bar">
            <div>
                <div class="income-title">Total Uang di Laci (Modal: Rp <span id="displayModalAwal">0</span>)</div>
                <div class="laci-amount">Rp <span id="displayUangLaci">0</span></div>
            </div>
            <div class="header-actions">
                <button class="btn btn-modal" onclick="aturModalAwalPrompt()">⚙️ Modal</button>
                <button class="btn btn-reset" onclick="resetUangLaci()">🔄 Laci</button>
                <button class="btn btn-backup" onclick="backupDataJson()" title="Simpan Cadangan Data">💾 Backup</button>
                <button class="btn btn-backup" onclick="document.getElementById('fileRestoreInput').click()" title="Pulihkan Data dari File">📂 Restore</button>
                <input type="file" id="fileRestoreInput" style="display:none" accept=".json" onchange="restoreDataJson(event)">
                <button class="btn btn-theme" onclick="toggleTheme()">🌙 <span id="themeText">Dark</span></button>
            </div>
        </div>
    </div>

    <!-- GRID UTAMA -->
    <div class="app-grid">
        <div>
            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                    <h2 style="margin:0;">⚙️ Kelola & Tata Menu</h2>
                    <small style="color:var(--text-muted); font-size:11px;">Geser kartu / klik ◀ ▶ untuk menata urutan</small>
                </div>
                
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                    <input type="text" id="newKategoriInput" placeholder="Tambah kategori baru (misal: Snack)">
                    <button class="btn btn-primary" style="white-space: nowrap;" onclick="tambahKategoriBaru()">+ Kategori</button>
                </div>

                <div class="form-grid">
                    <input type="text" id="newNama" placeholder="Nama menu baru">
                    <select id="newKategoriSelect"></select>
                    <input type="text" id="newHarga" placeholder="Harga (Rp)" oninput="formatAngkaOnly(this)">
                    <button class="btn btn-primary" onclick="tambahMenuBaru()">+ Menu</button>
                </div>

                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text" id="searchMenuInput" placeholder="Cari menu cepat..." oninput="renderMenu()">
                </div>

                <div class="filter-tabs" id="filterTabsContainer"></div>
                <div class="menu-grid" id="menuGrid"></div>
            </div>

            <div class="card">
                <h2>📦 Daftar Barang Terjual Hari Ini</h2>
                <div class="sold-items-container" id="soldItemsContainer">
                    <span style="font-size: 13px; color: var(--text-muted);">Belum ada barang terjual hari ini</span>
                </div>
            </div>
        </div>

        <div>
            <div class="card" style="padding: 16px 20px;">
                <h3>📌 Pesanan Gantung / Belum Bayar</h3>
                <div class="pending-container" id="pendingListContainer">
                    <span style="font-size: 13px; color: var(--text-muted);">Tidak ada pesanan gantung</span>
                </div>
            </div>

            <div class="card">
                <h2>🧾 Rincian Pesanan</h2>
                
                <div class="cart-list" id="cartList">
                    <p style="text-align: center; color: var(--text-muted); padding: 20px 0;">Belum ada pesanan dipilih</p>
                </div>

                <div class="highlight-box">
                    <div class="total-display-card">
                        <span class="total-label">Total Belanja</span>
                        <span class="total-value">Rp <span id="displayTotal">0</span></span>
                    </div>

                    <div class="pay-method-tabs">
                        <button class="pay-tab-btn active" id="tabTunai" onclick="gantiMetodeBayar('tunai')">💵 Tunai (Cash)</button>
                        <button class="pay-tab-btn" id="tabQris" onclick="gantiMetodeBayar('qris')">📱 QRIS / Non-Tunai</button>
                    </div>

                    <div id="sectionTunai">
                        <div>
                            <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 6px; color: var(--text-muted); text-transform: uppercase;">Uang Pembeli (Rp):</label>
                            <input type="text" id="inputBayar" class="pay-input" placeholder="0" oninput="formatAngkaOnly(this); hitungKembalian();">
                        </div>

                        <div class="quick-cash" id="quickCashContainer"></div>

                        <div style="display: flex; gap: 6px; margin-bottom: 8px;">
                            <input type="text" id="customCashInput" placeholder="Tambah tombol nominal cepat..." style="font-size: 12px; padding: 7px 10px;" oninput="formatAngkaOnly(this)">
                            <button class="btn btn-primary" style="font-size: 12px; padding: 7px 12px; white-space: nowrap;" onclick="tambahPilihanUang()">+ Tombol</button>
                        </div>

                        <div class="kembalian-display-card" id="kembalianContainer">
                            <span class="kembalian-label" id="kembalianLabel">Kembalian</span>
                            <span class="kembalian-value" id="displayKembalian">Rp 0</span>
                        </div>
                    </div>

                    <div id="sectionQris" style="display: none; padding: 15px 0; text-align: center;">
                        <div style="font-size: 14px; font-weight: 700; color: var(--info); margin-bottom: 6px;">PEMBAYARAN NON-TUNAI (QRIS / TRANSFER)</div>
                        <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">Dana masuk ke sistem non-tunai tanpa menambah uang fisik di laci.</div>
                        <div style="font-size: 18px; font-weight: 800; color: var(--success);" id="displayTotalQris">Rp 0</div>
                    </div>
                </div>

                <div class="action-btns">
                    <button class="btn" style="background:var(--border-color); color:var(--text-main); justify-content:center;" onclick="resetPesanan()">Reset</button>
                    <button class="btn" style="background:var(--warning); color:#fff; justify-content:center;" onclick="simpanPesananGantung()">Simpan Gantung</button>
                    <button class="btn btn-primary" style="justify-content:center;" onclick="selesaiTransaksi()">✅ Selesai & Bayar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h2 style="margin: 0;">📜 Log Aktivitas Sistem</h2>
            <button class="btn btn-reset" onclick="hapusSemuaLog()">Hapus Log</button>
        </div>
        <div class="log-list" id="logList">
            <p style="text-align: center; color: var(--text-muted); padding: 15px 0;">Belum ada catatan aktivitas</p>
        </div>
    </div>
</div>

<script>
    // Data Default
    const defaultCategories = ["Makanan", "Minuman", "Rokok"];
    const defaultMenus = [
        { id: 1, nama: "Ayam Goreng", kategori: "Makanan", harga: 15000 },
        { id: 2, nama: "Nasi Putih", kategori: "Makanan", harga: 5000 },
        { id: 3, nama: "Es Teh Manis", kategori: "Minuman", harga: 4000 },
        { id: 4, nama: "Kopi Hitam", kategori: "Minuman", harga: 5000 },
        { id: 5, nama: "Surya 16", kategori: "Rokok", harga: 35000 }
    ];
    const defaultCashOptions = [5000, 10000, 20000, 50000, 100000];

    // Load LocalStorage
    let categories = JSON.parse(localStorage.getItem('kasir_categories')) || defaultCategories;
    let menus = JSON.parse(localStorage.getItem('kasir_menus')) || defaultMenus;
    let cashOptions = JSON.parse(localStorage.getItem('kasir_cash_options')) || defaultCashOptions;
    let totalPendapatan = parseInt(localStorage.getItem('kasir_pendapatan')) || 0;
    let modalAwal = parseInt(localStorage.getItem('kasir_modal_awal')) || 0;
    let totalUangLaci = localStorage.getItem('kasir_uang_laci') !== null ? parseInt(localStorage.getItem('kasir_uang_laci')) : modalAwal;
    let logs = JSON.parse(localStorage.getItem('kasir_logs')) || [];
    let transactions = JSON.parse(localStorage.getItem('kasir_transactions')) || [];
    let pendingOrders = JSON.parse(localStorage.getItem('kasir_pending_orders')) || [];
    let soldItems = JSON.parse(localStorage.getItem('kasir_sold_items')) || {};
    let currentTheme = localStorage.getItem('kasir_theme') || 'light';

    let pesanan = {};
    let kategoriAktif = 'Semua';
    let totalBelanja = 0;
    let metodeBayarAktif = 'tunai';
    let draggedMenuIndex = null;

    // Apply Theme
    document.body.setAttribute('data-theme', currentTheme);
    document.getElementById('themeText').innerText = currentTheme === 'dark' ? 'Light' : 'Dark';

    function toggleTheme() {
        currentTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.body.setAttribute('data-theme', currentTheme);
        document.getElementById('themeText').innerText = currentTheme === 'dark' ? 'Light' : 'Dark';
        localStorage.setItem('kasir_theme', currentTheme);
    }

    function formatRupiah(angka) {
        return angka.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function formatAngkaOnly(input) {
        let value = input.value.replace(/\D/g, '');
        if (value === '') {
            input.value = '';
        } else {
            input.value = new Intl.NumberFormat('id-ID').format(value);
        }
    }

    function parseRupiahInput(idOrElement) {
        const el = typeof idOrElement === 'string' ? document.getElementById(idOrElement) : idOrElement;
        if (!el) return 0;
        const valStr = el.value.replace(/\./g, '');
        return parseInt(valStr) || 0;
    }

    function getWaktu() {
        const now = new Date();
        return now.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) + ' ' + 
               now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    }

    function simpanStorage() {
        localStorage.setItem('kasir_categories', JSON.stringify(categories));
        localStorage.setItem('kasir_menus', JSON.stringify(menus));
        localStorage.setItem('kasir_cash_options', JSON.stringify(cashOptions));
        localStorage.setItem('kasir_pendapatan', totalPendapatan.toString());
        localStorage.setItem('kasir_modal_awal', modalAwal.toString());
        localStorage.setItem('kasir_uang_laci', totalUangLaci.toString());
        localStorage.setItem('kasir_logs', JSON.stringify(logs));
        localStorage.setItem('kasir_transactions', JSON.stringify(transactions));
        localStorage.setItem('kasir_pending_orders', JSON.stringify(pendingOrders));
        localStorage.setItem('kasir_sold_items', JSON.stringify(soldItems));
    }

    // --- FITUR BACKUP & RESTORE DATA (JSON) ---
    function backupDataJson() {
        const dataBackup = {
            categories,
            menus,
            cashOptions,
            totalPendapatan,
            modalAwal,
            totalUangLaci,
            logs,
            transactions,
            pendingOrders,
            soldItems,
            version: "1.0",
            waktuBackup: getWaktu()
        };

        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(dataBackup, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `Backup_Data_Kasir_${new Date().toISOString().slice(0,10)}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
        tambahLog('info', '💾 Backup Data', 'Berhasil mengunduh file cadangan data (JSON)');
    }

    function restoreDataJson(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = JSON.parse(e.target.result);
                if (!data.menus || !data.categories) {
                    alert("Format file cadangan tidak valid!");
                    return;
                }

                if (confirm("⚠️ Pulihkan data dari file cadangan ini?\nSemua data menu, kategori, dan kas saat ini akan diperbarui sesuai file.")) {
                    categories = data.categories || defaultCategories;
                    menus = data.menus || defaultMenus;
                    cashOptions = data.cashOptions || defaultCashOptions;
                    totalPendapatan = data.totalPendapatan || 0;
                    modalAwal = data.modalAwal || 0;
                    totalUangLaci = data.totalUangLaci || modalAwal;
                    logs = data.logs || [];
                    transactions = data.transactions || [];
                    pendingOrders = data.pendingOrders || [];
                    soldItems = data.soldItems || {};

                    simpanStorage();
                    renderKategoriOptions();
                    renderFilterTabs();
                    renderMenu();
                    renderPesanan();
                    renderCashOptions();
                    renderLaci();
                    renderPendingOrders();
                    renderSoldItems();
                    renderLogs();

                    alert("✅ Data berhasil dipulihkan!");
                    tambahLog('info', '📂 Restore Data', 'Berhasil memulihkan data dari file cadangan');
                }
            } catch (err) {
                alert("Gagal membaca file JSON: " + err.message);
            }
            event.target.value = ''; // Reset input file
        };
        reader.readAsText(file);
    }

    // --- CUSTOM MODALS ---
    function customPromptModal(title, subtitle, defaultValue, callback) {
        const overlay = document.createElement('div');
        overlay.className = 'modal-overlay';
        const formattedDefault = defaultValue ? new Intl.NumberFormat('id-ID').format(defaultValue) : '';
        overlay.innerHTML = `
            <div class="modal-box">
                <h3>${title}</h3>
                <p>${subtitle}</p>
                <input type="text" id="modalInput" value="${formattedDefault}" placeholder="0" style="font-size:20px; font-weight:800; text-align:right;" oninput="formatAngkaOnly(this)">
                <div class="modal-actions">
                    <button class="btn" style="background:var(--border-color); color:var(--text-main);" id="modalCancel">Batal</button>
                    <button class="btn btn-primary" id="modalSubmit">Simpan</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
        const input = document.getElementById('modalInput');
        input.focus();
        input.select();

        document.getElementById('modalCancel').onclick = () => document.body.removeChild(overlay);
        document.getElementById('modalSubmit').onclick = () => {
            const val = parseRupiahInput(input);
            document.body.removeChild(overlay);
            callback(val);
        };
        input.onkeydown = (e) => {
            if (e.key === 'Enter') document.getElementById('modalSubmit').click();
            if (e.key === 'Escape') document.getElementById('modalCancel').click();
        };
    }

    function customTextPromptModal(title, subtitle, callback) {
        const overlay = document.createElement('div');
        overlay.className = 'modal-overlay';
        overlay.innerHTML = `
            <div class="modal-box">
                <h3>${title}</h3>
                <p>${subtitle}</p>
                <input type="text" id="modalTextInput" placeholder="Masukkan keterangan...">
                <div class="modal-actions">
                    <button class="btn" style="background:var(--border-color); color:var(--text-main);" id="modalCancel">Batal</button>
                    <button class="btn btn-primary" id="modalSubmit">Lanjutkan</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);
        const input = document.getElementById('modalTextInput');
        input.focus();

        document.getElementById('modalCancel').onclick = () => document.body.removeChild(overlay);
        document.getElementById('modalSubmit').onclick = () => {
            const val = input.value.trim();
            document.body.removeChild(overlay);
            callback(val);
        };
        input.onkeydown = (e) => {
            if (e.key === 'Enter') document.getElementById('modalSubmit').click();
            if (e.key === 'Escape') document.getElementById('modalCancel').click();
        };
    }

    // --- EDIT MENU MODAL ---
    function bukaModalEditMenu(id) {
        const menu = menus.find(m => m.id === id);
        if (!menu) return;

        const overlay = document.createElement('div');
        overlay.className = 'modal-overlay';
        const optionsHtml = categories.map(cat => 
            `<option value="${cat}" ${cat === menu.kategori ? 'selected' : ''}>${cat}</option>`
        ).join('');

        overlay.innerHTML = `
            <div class="modal-box">
                <h3>✏️ Edit Menu</h3>
                <div class="modal-field">
                    <label>Nama Barang / Menu</label>
                    <input type="text" id="editMenuNama" value="${menu.nama}">
                </div>
                <div class="modal-field">
                    <label>Kategori</label>
                    <select id="editMenuKategori">${optionsHtml}</select>
                </div>
                <div class="modal-field">
                    <label>Harga Satuan (Rp)</label>
                    <input type="text" id="editMenuHarga" value="${formatRupiah(menu.harga)}" oninput="formatAngkaOnly(this)">
                </div>
                <div class="modal-actions">
                    <button class="btn" style="background:var(--border-color); color:var(--text-main);" id="editCancel">Batal</button>
                    <button class="btn btn-primary" id="editSave">Simpan Perubahan</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);

        document.getElementById('editCancel').onclick = () => document.body.removeChild(overlay);
        document.getElementById('editSave').onclick = () => {
            const newNama = document.getElementById('editMenuNama').value.trim();
            const newKat = document.getElementById('editMenuKategori').value;
            const newHarga = parseRupiahInput('editMenuHarga');

            if (!newNama || isNaN(newHarga) || newHarga <= 0) {
                alert("Nama menu dan harga harus diisi dengan benar!");
                return;
            }

            const oldNama = menu.nama;
            const oldHarga = menu.harga;
            menu.nama = newNama;
            menu.kategori = newKat;
            menu.harga = newHarga;

            simpanStorage();
            document.body.removeChild(overlay);
            renderMenu();
            renderPesanan();
            tambahLog('info', '✏️ Edit Menu', `${oldNama} (Rp ${formatRupiah(oldHarga)}) ➔ ${newNama} [${newKat}] (Rp ${formatRupiah(newHarga)})`);
        };
    }

    // --- ATUR MODAL AWAL & RESET LACI ---
    function aturModalAwalPrompt() {
        customPromptModal(
            "Atur Modal Awal Kasir",
            "Masukkan jumlah modal awal fisik di laci saat ini:",
            modalAwal,
            (val) => {
                if (isNaN(val) || val < 0) return alert("Nominal tidak valid!");
                const selisih = val - modalAwal;
                modalAwal = val;
                totalUangLaci = Math.max(0, totalUangLaci + selisih);
                simpanStorage();
                renderLaci();
                tambahLog('info', '⚙️ Atur Modal Awal', `Modal awal laci diatur ke: Rp ${formatRupiah(modalAwal)}`);
            }
        );
    }

    function resetUangLaci() {
        if (confirm(`Reset Total Uang di Laci kembali ke Modal Awal (Rp ${formatRupiah(modalAwal)})?`)) {
            const prevLaci = totalUangLaci;
            totalUangLaci = modalAwal;
            simpanStorage();
            renderLaci();
            tambahLog('reset', '🔄 Reset Uang Laci', `Uang di laci Rp ${formatRupiah(prevLaci)} dikembalikan ke Modal Awal: Rp ${formatRupiah(modalAwal)}`);
        }
    }

    function renderLaci() {
        document.getElementById('displayPendapatan').innerText = formatRupiah(totalPendapatan);
        document.getElementById('displayUangLaci').innerText = formatRupiah(totalUangLaci);
        document.getElementById('displayModalAwal').innerText = formatRupiah(modalAwal);
    }

    // --- KURANGI PENDAPATAN / LACI ---
    function kurangiPendapatanPrompt() {
        customPromptModal(
            "Kurangi Pendapatan / Uang Laci",
            "Masukkan nominal yang ingin dikurangi:",
            0,
            (nom) => {
                if (isNaN(nom) || nom <= 0) return;

                customTextPromptModal(
                    "Keterangan Pengurangan",
                    "Wajib masukkan keterangan / alasan (misal: Beli es batu, setor tunai):",
                    (ket) => {
                        if (!ket) {
                            alert("Pengurangan dibatalkan karena keterangan wajib diisi!");
                            return;
                        }

                        let sumberDana = "Tunai (Laci Kasir)";
                        if (totalUangLaci < nom) {
                            let kekurangan = nom - totalUangLaci;
                            let konfirmasiNonTunai = confirm(
                                `⚠️ Perhatian!\nUang fisik di laci kasir (Rp ${formatRupiah(totalUangLaci)}) tidak cukup untuk mengurangi Rp ${formatRupiah(nom)} (kurang Rp ${formatRupiah(kekurangan)}).\n\nApakah Anda ingin menggunakan cadangan Non-Tunai (QRIS) untuk menutupi pengurangan ini?`
                            );
                            
                            if (!konfirmasiNonTunai) {
                                alert("Pengurangan dibatalkan.");
                                return;
                            } else {
                                sumberDana = totalUangLaci > 0 ? "Campuran (Laci Kasir + Non-Tunai)" : "Non-Tunai (QRIS/Rekening)";
                                totalUangLaci = 0;
                            }
                        } else {
                            totalUangLaci -= nom;
                        }

                        const prevPendapatan = totalPendapatan;
                        totalPendapatan = Math.max(0, totalPendapatan - nom);
                        simpanStorage();
                        renderLaci();

                        tambahLog(
                            'keluar', 
                            `➖ Kurangi Kas / Pendapatan (-Rp ${formatRupiah(nom)})`, 
                            `Sumber Dana: ${sumberDana}\nKeterangan: ${ket}\nSisa Pendapatan: Rp ${formatRupiah(prevPendapatan)} ➔ Rp ${formatRupiah(totalPendapatan)}`
                        );
                    }
                );
            }
        );
    }

    // --- METODE PEMBAYARAN ---
    function gantiMetodeBayar(metode) {
        metodeBayarAktif = metode;
        const tabTunai = document.getElementById('tabTunai');
        const tabQris = document.getElementById('tabQris');
        const secTunai = document.getElementById('sectionTunai');
        const secQris = document.getElementById('sectionQris');

        if (metode === 'tunai') {
            tabTunai.classList.add('active');
            tabQris.classList.remove('active');
            secTunai.style.display = 'block';
            secQris.style.display = 'none';
        } else {
            tabQris.classList.add('active');
            tabTunai.classList.remove('active');
            secQris.style.display = 'block';
            secTunai.style.display = 'none';
            document.getElementById('displayTotalQris').innerText = "Rp " + formatRupiah(totalBelanja);
        }
    }

    // --- KATEGORI & MENU + TATA URUTAN ---
    function renderKategoriOptions() {
        const select = document.getElementById('newKategoriSelect');
        select.innerHTML = categories.map(cat => `<option value="${cat}">${cat}</option>`).join('');
    }

    function tambahKategoriBaru() {
        const name = document.getElementById('newKategoriInput').value.trim();
        if (!name) return alert("Masukkan nama kategori!");
        if (categories.includes(name)) return alert("Kategori sudah ada!");
        
        categories.push(name);
        simpanStorage();
        document.getElementById('newKategoriInput').value = '';
        renderKategoriOptions();
        renderFilterTabs();
        tambahLog('info', '➕ Kategori Baru', `Menambahkan kategori: ${name}`);
    }

    function renderFilterTabs() {
        const container = document.getElementById('filterTabsContainer');
        let html = `<button class="tab-btn ${kategoriAktif === 'Semua' ? 'active' : ''}" onclick="filterKat('Semua', this)">Semua</button>`;
        html += categories.map(cat => `
            <button class="tab-btn ${kategoriAktif === cat ? 'active' : ''}" onclick="filterKat('${cat}', this)">${cat}</button>
        `).join('');
        container.innerHTML = html;
    }

    function filterKat(kat, btn) {
        kategoriAktif = kat;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderMenu();
    }

    function tambahMenuBaru() {
        const nama = document.getElementById('newNama').value.trim();
        const kategori = document.getElementById('newKategoriSelect').value;
        const harga = parseRupiahInput('newHarga');

        if (!nama || isNaN(harga) || harga <= 0) return alert("Isi data menu dan harga yang benar!");

        menus.push({ id: Date.now(), nama, kategori, harga });
        simpanStorage();
        tambahLog('info', '➕ Menu Ditambahkan', `${nama} (${kategori}) - Rp ${formatRupiah(harga)}`);
        
        document.getElementById('newNama').value = '';
        document.getElementById('newHarga').value = '';
        renderMenu();
    }

    function hapusMenu(id) {
        const m = menus.find(x => x.id === id);
        if (!m) return;
        if (confirm(`Hapus menu "${m.nama}"?`)) {
            menus = menus.filter(x => x.id !== id);
            delete pesanan[id];
            simpanStorage();
            tambahLog('info', '🗑️ Menu Dihapus', m.nama);
            renderMenu();
            renderPesanan();
        }
    }

    function geserMenu(id, arah) {
        const idx = menus.findIndex(m => m.id === id);
        if (idx === -1) return;
        const targetIdx = idx + arah;
        if (targetIdx < 0 || targetIdx >= menus.length) return;

        const temp = menus[idx];
        menus[idx] = menus[targetIdx];
        menus[targetIdx] = temp;

        simpanStorage();
        renderMenu();
    }

    function handleDragStart(e, id) {
        draggedMenuIndex = menus.findIndex(m => m.id === id);
        e.dataTransfer.effectAllowed = 'move';
    }

    function handleDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }

    function handleDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }

    function handleDrop(e, targetId) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        const targetIndex = menus.findIndex(m => m.id === targetId);
        if (draggedMenuIndex === null || targetIndex === -1 || draggedMenuIndex === targetIndex) return;

        const [movedItem] = menus.splice(draggedMenuIndex, 1);
        menus.splice(targetIndex, 0, movedItem);
        draggedMenuIndex = null;

        simpanStorage();
        renderMenu();
    }

    function ubahJumlah(id, delta) {
        if (!pesanan[id]) pesanan[id] = 0;
        pesanan[id] += delta;
        if (pesanan[id] <= 0) delete pesanan[id];
        renderMenu();
        renderPesanan();
    }

    function renderMenu() {
        const grid = document.getElementById('menuGrid');
        const keyword = document.getElementById('searchMenuInput').value.toLowerCase().trim();
        
        let filtered = kategoriAktif === 'Semua' ? menus : menus.filter(m => m.kategori === kategoriAktif);
        if (keyword) {
            filtered = filtered.filter(m => m.nama.toLowerCase().includes(keyword) || m.kategori.toLowerCase().includes(keyword));
        }

        if (filtered.length === 0) {
            grid.innerHTML = `<p style="grid-column: 1/-1; text-align:center; color:var(--text-muted); padding:20px;">Menu tidak ditemukan</p>`;
            return;
        }

        grid.innerHTML = filtered.map(item => {
            const qty = pesanan[item.id] || 0;
            return `
                <div class="menu-item" draggable="true" 
                     ondragstart="handleDragStart(event, ${item.id})"
                     ondragover="handleDragOver(event)"
                     ondragleave="handleDragLeave(event)"
                     ondrop="handleDrop(event, ${item.id})">
                    <div>
                        <div class="menu-top-bar">
                            <span class="badge">${item.kategori}</span>
                            <div class="menu-card-actions">
                                <button class="btn-icon-mini" onclick="bukaModalEditMenu(${item.id})" title="Edit Menu">✏️</button>
                                <button class="btn-icon-mini del" onclick="hapusMenu(${item.id})" title="Hapus Menu">✕</button>
                            </div>
                        </div>
                        <div class="menu-name">${item.nama}</div>
                        <div class="menu-price">Rp ${formatRupiah(item.harga)}</div>
                    </div>
                    <div>
                        <div class="menu-reorder-bar">
                            <button class="btn-move" onclick="geserMenu(${item.id}, -1)" title="Geser Kiri">◀ Geser</button>
                            <button class="btn-move" onclick="geserMenu(${item.id}, 1)" title="Geser Kanan">Geser ▶</button>
                        </div>
                        <div class="qty-control">
                            <button class="qty-btn btn-minus" onclick="ubahJumlah(${item.id}, -1)">−</button>
                            <span class="qty-val">${qty}</span>
                            <button class="qty-btn btn-plus" onclick="ubahJumlah(${item.id}, 1)">+</button>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // --- KERANJANG ---
    function renderPesanan() {
        const cartList = document.getElementById('cartList');
        totalBelanja = 0;
        let ada = false;
        let html = '';

        menus.forEach(item => {
            const qty = pesanan[item.id];
            if (qty > 0) {
                ada = true;
                const sub = item.harga * qty;
                totalBelanja += sub;
                html += `
                    <div class="cart-row">
                        <div><strong>${item.nama}</strong><br><small style="color:var(--text-muted)">@${formatRupiah(item.harga)}</small></div>
                        <div style="display:flex; align-items:center; gap:5px;">
                            <button class="qty-btn btn-minus" style="width:24px;height:24px;font-size:12px;" onclick="ubahJumlah(${item.id}, -1)">−</button>
                            <span style="font-weight:bold; min-width:18px; text-align:center;">${qty}</span>
                            <button class="qty-btn btn-plus" style="width:24px;height:24px;font-size:12px;" onclick="ubahJumlah(${item.id}, 1)">+</button>
                        </div>
                        <div class="cart-subtotal">Rp ${formatRupiah(sub)}</div>
                    </div>
                `;
            }
        });

        cartList.innerHTML = ada ? html : `<p style="text-align: center; color: var(--text-muted); padding: 20px 0;">Belum ada pesanan dipilih</p>`;
        document.getElementById('displayTotal').innerText = formatRupiah(totalBelanja);
        document.getElementById('displayTotalQris').innerText = "Rp " + formatRupiah(totalBelanja);
        hitungKembalian();
    }

    function renderSoldItems() {
        const container = document.getElementById('soldItemsContainer');
        const keys = Object.keys(soldItems);
        if (keys.length === 0) {
            container.innerHTML = `<span style="font-size: 13px; color: var(--text-muted);">Belum ada barang terjual hari ini</span>`;
            return;
        }

        container.innerHTML = keys.map(nama => `
            <div class="sold-badge">
                ${nama} <span>${soldItems[nama]}</span>
            </div>
        `).join('');
    }

    // --- PESANAN GANTUNG ---
    function simpanPesananGantung() {
        if (Object.keys(pesanan).length === 0) return alert("Keranjang masih kosong!");
        const namaCatatan = prompt("Beri nama pesanan gantung ini (misal: Meja 1 / Mas Budi):");
        if (!namaCatatan || !namaCatatan.trim()) return;

        let detailList = [];
        menus.forEach(m => {
            if (pesanan[m.id]) {
                detailList.push({ nama: m.nama, qty: pesanan[m.id], subtotal: m.harga * pesanan[m.id] });
            }
        });

        const draft = {
            id: Date.now(),
            nama: namaCatatan.trim(),
            items: { ...pesanan },
            detailList: detailList,
            total: totalBelanja,
            waktu: getWaktu()
        };

        pendingOrders.push(draft);
        simpanStorage();
        tambahLog('info', '📌 Pesanan Digantung', `${namaCatatan.trim()} (Total: Rp ${formatRupiah(totalBelanja)})`);
        resetPesanan();
        renderPendingOrders();
    }

    function togglePendingDetail(id) {
        const el = document.getElementById(`pending-detail-${id}`);
        const btn = document.getElementById(`pending-arrow-${id}`);
        if (el.classList.contains('open')) {
            el.classList.remove('open');
            btn.innerText = '▼';
        } else {
            el.classList.add('open');
            btn.innerText = '▲';
        }
    }

    function renderPendingOrders() {
        const container = document.getElementById('pendingListContainer');
        if (pendingOrders.length === 0) {
            container.innerHTML = `<span style="font-size: 13px; color: var(--text-muted);">Tidak ada pesanan gantung</span>`;
            return;
        }

        container.innerHTML = pendingOrders.map(ord => {
            let itemsHtml = '';
            if (ord.detailList && ord.detailList.length > 0) {
                itemsHtml = ord.detailList.map(d => `
                    <li><span>${d.nama} (${d.qty}x)</span><span>Rp ${formatRupiah(d.subtotal)}</span></li>
                `).join('');
            }

            return `
                <div class="pending-card">
                    <div class="pending-header" onclick="togglePendingDetail(${ord.id})">
                        <div class="pending-info">
                            <button class="btn-toggle-pending" id="pending-arrow-${ord.id}">▼</button>
                            <div>
                                <div class="pending-title">${ord.nama}</div>
                                <div class="pending-total">Rp ${formatRupiah(ord.total)} • <small style="color:var(--text-muted);">${ord.waktu}</small></div>
                            </div>
                        </div>
                        <div class="pending-actions">
                            <button class="btn-load-pending" onclick="event.stopPropagation(); muatPesananGantung(${ord.id})">Muat</button>
                            <button class="btn-del-pending" onclick="event.stopPropagation(); hapusPesananGantung(${ord.id})">✕</button>
                        </div>
                    </div>
                    <div class="pending-details" id="pending-detail-${ord.id}">
                        <ul>${itemsHtml}</ul>
                    </div>
                </div>
            `;
        }).join('');
    }

    function muatPesananGantung(id) {
        const ord = pendingOrders.find(x => x.id === id);
        if (!ord) return;
        pesanan = { ...ord.items };
        pendingOrders = pendingOrders.filter(x => x.id !== id);
        simpanStorage();
        renderMenu();
        renderPesanan();
        renderPendingOrders();
        tambahLog('info', '📥 Pesanan Dimuat', `Memuat pesanan gantung: ${ord.nama}`);
    }

    function hapusPesananGantung(id) {
        if (confirm("Hapus pesanan gantung ini?")) {
            pendingOrders = pendingOrders.filter(x => x.id !== id);
            simpanStorage();
            renderPendingOrders();
        }
    }

    // --- PEMBAYARAN ---
    function renderCashOptions() {
        const container = document.getElementById('quickCashContainer');
        let html = `<span class="cash-chip" style="background:var(--primary); color:white;" onclick="setBayar(${totalBelanja})">Uang Pas</span>`;
        cashOptions.forEach((nom, idx) => {
            html += `
                <span class="cash-chip" onclick="setBayar(${nom})">
                    Rp ${formatRupiah(nom)}
                    <span class="del-chip" onclick="event.stopPropagation(); hapusChipUang(${idx})">×</span>
                </span>
            `;
        });
        container.innerHTML = html;
    }

    function setBayar(val) {
        const input = document.getElementById('inputBayar');
        input.value = new Intl.NumberFormat('id-ID').format(val);
        hitungKembalian();
    }

    function tambahPilihanUang() {
        const val = parseRupiahInput('customCashInput');
        if (isNaN(val) || val <= 0) return alert("Masukkan nominal valid!");
        if (!cashOptions.includes(val)) {
            cashOptions.push(val);
            cashOptions.sort((a,b)=>a-b);
            simpanStorage();
            renderCashOptions();
        }
        document.getElementById('customCashInput').value = '';
    }

    function hapusChipUang(idx) {
        cashOptions.splice(idx, 1);
        simpanStorage();
        renderCashOptions();
    }

    function hitungKembalian() {
        renderCashOptions();
        const bayar = parseRupiahInput('inputBayar');
        const kembalian = bayar - totalBelanja;
        const display = document.getElementById('displayKembalian');
        const label = document.getElementById('kembalianLabel');
        const box = document.getElementById('kembalianContainer');

        if (totalBelanja === 0 && bayar === 0) {
            label.innerText = "Kembalian";
            display.innerText = "Rp 0";
            box.classList.remove('kurang');
            return;
        }

        if (kembalian < 0) {
            label.innerText = "Uang Kurang";
            display.innerText = "Rp " + formatRupiah(Math.abs(kembalian));
            box.classList.add('kurang');
        } else {
            label.innerText = "Kembalian";
            display.innerText = "Rp " + formatRupiah(kembalian);
            box.classList.remove('kurang');
        }
    }

    function resetPesanan() {
        pesanan = {};
        document.getElementById('inputBayar').value = '';
        renderMenu();
        renderPesanan();
    }

    function selesaiTransaksi() {
        if (totalBelanja === 0) return alert("Keranjang masih kosong!");
        
        let rincian = [];
        menus.forEach(m => {
            const qty = pesanan[m.id];
            if (qty > 0) {
                rincian.push(`${m.nama} (${qty}x)`);
                soldItems[m.nama] = (soldItems[m.nama] || 0) + qty;
            }
        });

        totalPendapatan += totalBelanja;
        let infoPembayaran = "";

        if (metodeBayarAktif === 'tunai') {
            const bayar = parseRupiahInput('inputBayar');
            if (bayar < totalBelanja) return alert("Uang pembayaran masih kurang!");
            const kembalian = bayar - totalBelanja;

            totalUangLaci += totalBelanja;
            infoPembayaran = `Tunai (Cash) | Bayar: Rp ${formatRupiah(bayar)} | Kembalian: Rp ${formatRupiah(kembalian)}`;

            transactions.unshift({
                id: Date.now(),
                waktu: getWaktu(),
                items: rincian.join(', '),
                total: totalBelanja,
                metode: 'Tunai (Cash)',
                bayar: bayar,
                kembalian: kembalian
            });
        } else {
            infoPembayaran = `QRIS / Non-Tunai`;

            transactions.unshift({
                id: Date.now(),
                waktu: getWaktu(),
                items: rincian.join(', '),
                total: totalBelanja,
                metode: 'QRIS / Non-Tunai',
                bayar: totalBelanja,
                kembalian: 0
            });
        }

        simpanStorage();
        renderLaci();
        renderSoldItems();

        tambahLog('masuk', `✅ Transaksi Sukses (+Rp ${formatRupiah(totalBelanja)})`, `${rincian.join(', ')}\nMetode: ${infoPembayaran}`);
        resetPesanan();
    }

    function resetPendapatan() {
        if (confirm("Reset total pendapatan hari ini menjadi Rp 0 dan bersihkan riwayat transaksi? Uang laci akan dikembalikan setara modal awal.")) {
            totalPendapatan = 0;
            totalUangLaci = modalAwal;
            soldItems = {};
            transactions = [];
            simpanStorage();
            renderLaci();
            renderSoldItems();
            tambahLog('reset', `🔄 Reset Pendapatan Harian`, `Pendapatan di-reset ke 0. Uang laci disesuaikan ke modal awal: Rp ${formatRupiah(modalAwal)}`);
        }
    }

    function tambahLog(tipe, judul, detail) {
        logs.unshift({ id: Date.now(), waktu: getWaktu(), tipe, judul, detail });
        simpanStorage();
        renderLogs();
    }

    function hapusLog(id) {
        logs = logs.filter(l => l.id !== id);
        simpanStorage();
        renderLogs();
    }

    function hapusSemuaLog() {
        if (logs.length > 0 && confirm("Hapus semua riwayat log sistem?")) {
            logs = [];
            simpanStorage();
            renderLogs();
        }
    }

    function renderLogs() {
        const list = document.getElementById('logList');
        if (logs.length === 0) {
            list.innerHTML = `<p style="text-align: center; color: var(--text-muted); padding: 15px 0;">Belum ada catatan aktivitas</p>`;
            return;
        }
        list.innerHTML = logs.map(l => `
            <div class="log-item ${l.tipe}">
                <div>
                    <div class="log-time">${l.waktu}</div>
                    <div class="log-title">${l.judul}</div>
                    <div class="log-detail">${l.detail}</div>
                </div>
                <button class="btn" style="background:none; color:var(--danger); padding:0;" onclick="hapusLog(${l.id})">✕</button>
            </div>
        `).join('');
    }

    // --- DOWNLOAD LAPORAN TEMA GELAP ---
    function downloadLaporan() {
        let soldHtml = Object.keys(soldItems).map(k => `
            <div class="sold-chip">
                <span>${k}</span>
                <strong>${soldItems[k]}x</strong>
            </div>
        `).join('');
        if (!soldHtml) soldHtml = '<p class="muted">Belum ada barang terjual</p>';

        let transHtml = transactions.map((t, index) => `
            <tr>
                <td>${transactions.length - index}</td>
                <td>${t.waktu}</td>
                <td>${t.items}</td>
                <td><b>${t.metode}</b></td>
                <td class="text-green"><b>Rp ${formatRupiah(t.total)}</b></td>
                <td>Rp ${formatRupiah(t.bayar)}</td>
                <td>Rp ${formatRupiah(t.kembalian)}</td>
            </tr>
        `).join('');
        if (!transHtml) transHtml = '<tr><td colspan="7" style="text-align:center;" class="muted">Belum ada transaksi berhasil</td></tr>';

        let logsHtml = logs.map(l => `
            <tr>
                <td>${l.waktu}</td>
                <td><b>${l.judul}</b></td>
                <td>${l.detail.replace(/\n/g, '<br>')}</td>
            </tr>
        `).join('');
        if (!logsHtml) logsHtml = '<tr><td colspan="3" style="text-align:center;" class="muted">Tidak ada log aktivitas sistem</td></tr>';

        const htmlReport = `
        <!DOCTYPE html>
        <html lang="id">
        <head>
            <meta charset="UTF-8">
            <title>Laporan Kasir - ${getWaktu()}</title>
            <style>
                body { font-family: 'Segoe UI', Inter, Arial, sans-serif; padding: 30px; color: #f8fafc; background: #090d16; margin: 0; }
                .container { max-width: 950px; margin: 0 auto; background: #151c2c; padding: 40px; border-radius: 16px; border: 1px solid #273248; box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
                .header { border-bottom: 1px solid #273248; padding-bottom: 20px; margin-bottom: 25px; }
                h1 { color: #ffffff; margin: 0 0 6px 0; font-size: 24px; }
                .date { color: #94a3b8; font-size: 13px; }
                .summary-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 30px; }
                .summary-card { background: #1e283d; padding: 22px 20px; border-radius: 12px; border-left: 5px solid #34d399; }
                .summary-card.laci { border-left-color: #38bdf8; }
                .summary-card.modal { border-left-color: #fbbf24; }
                .summary-card h3 { margin: 0 0 5px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; }
                .summary-card .amount { font-size: 22px; font-weight: 800; color: #34d399; }
                .summary-card.laci .amount { color: #38bdf8; }
                .summary-card.modal .amount { color: #fbbf24; }
                h2 { font-size: 17px; margin-top: 32px; margin-bottom: 14px; color: #e2e8f0; }
                .sold-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
                .sold-chip { background: #1e283d; border: 1px solid #334155; padding: 8px 14px; border-radius: 8px; font-size: 13px; display: flex; gap: 10px; align-items: center; }
                .sold-chip strong { background: #6366f1; color: white; padding: 2px 8px; border-radius: 6px; font-size: 12px; }
                table { width: 100%; border-collapse: collapse; font-size: 13px; background: #0f1522; border-radius: 10px; overflow: hidden; }
                th, td { border: 1px solid #273248; padding: 11px 13px; text-align: left; vertical-align: top; }
                th { background: #1e283d; color: #cbd5e1; font-weight: 600; text-transform: uppercase; font-size: 11px; }
                tr:nth-child(even) td { background: #131a29; }
                .text-green { color: #34d399; }
                .muted { color: #64748b; }
                .footer { margin-top: 40px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #273248; padding-top: 20px; }
            </style>
        </head>
        <body>
            <div class="container">
                <div class="header">
                    <h1>📊 Laporan Keuangan & Penjualan Lengkap</h1>
                    <div class="date">Dicetak pada: ${getWaktu()}</div>
                </div>

                <div class="summary-grid">
                    <div class="summary-card modal">
                        <h3>Modal Awal Kasir</h3>
                        <div class="amount">Rp ${formatRupiah(modalAwal)}</div>
                    </div>
                    <div class="summary-card">
                        <h3>Total Pendapatan Bersih</h3>
                        <div class="amount">Rp ${formatRupiah(totalPendapatan)}</div>
                    </div>
                    <div class="summary-card laci">
                        <h3>Fisik Uang di Laci</h3>
                        <div class="amount">Rp ${formatRupiah(totalUangLaci)}</div>
                    </div>
                </div>

                <h2>📦 Ringkasan Barang Terjual</h2>
                <div class="sold-grid">${soldHtml}</div>

                <h2>🧾 Daftar Transaksi Berhasil (Tunai & QRIS)</h2>
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Waktu</th>
                            <th>Item</th>
                            <th>Metode</th>
                            <th>Total</th>
                            <th>Bayar</th>
                            <th>Kembalian</th>
                        </tr>
                    </thead>
                    <tbody>${transHtml}</tbody>
                </table>

                <h2>📜 Log Aktivitas Sistem Lengkap</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Waktu</th>
                            <th>Aktivitas</th>
                            <th>Keterangan Detail</th>
                        </tr>
                    </thead>
                    <tbody>${logsHtml}</tbody>
                </table>

                <div class="footer">Laporan dihasilkan secara otomatis oleh Aplikasi Kasir POS Pro</div>
            </div>
        </body>
        </html>
        `;

        const blob = new Blob([htmlReport], { type: 'text/html;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Laporan_Kasir_${new Date().toISOString().slice(0,10)}.html`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    // Inisialisasi awal
    renderKategoriOptions();
    renderFilterTabs();
    renderMenu();
    renderPesanan();
    renderCashOptions();
    renderLaci();
    renderPendingOrders();
    renderSoldItems();
    renderLogs();
</script>

</body>
</html>
